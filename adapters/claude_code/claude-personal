#!/bin/sh
# Claude Code started in the user's personal world: the plugin loaded and its mode on from the first message.
# The memory server must be running (PERSONAL_MEMORY_URL, default http://127.0.0.1:7110; on another
# machine also PERSONAL_MEMORY_TOKEN, the token beside its journal).
here=$(dirname "$(readlink -f "$0")")
# A first `ask` may wait while the memory reads: a quiet tool call is not cut off.
MCP_TOOL_TIMEOUT=${MCP_TOOL_TIMEOUT:-1800000} CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT=${CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT:-0} \
# One memory of the user: Claude Code's own auto-memory is off, or facts go to its files instead.
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 PERSONAL_WORLD=on exec claude --plugin-dir "$here/plugin" "$@"
