{
  "name": "Membership",
  "description": "A person belonging to an organization: a job, studies, a club, volunteering.",
  "relation": {
    "kind": "membership",
    "from": [
      "Person"
    ],
    "to": [
      "Organization"
    ],
    "asymmetric": true,
    "irreflexive": true,
    "transitive_via": "PartOf",
    "reverse": "members",
    "labels": [
      "works at",
      "employee",
      "student",
      "member",
      "volunteer"
    ],
    "role_text": "title",
    "roles": [
      {
        "name": "ceo",
        "inverse": "organization",
        "max": 1,
        "synonyms": [
          "ceo",
          "chief executive",
          "chief executive officer",
          "general director",
          "managing director"
        ]
      },
      {
        "name": "chair",
        "inverse": "organization",
        "max": 1,
        "synonyms": [
          "chair",
          "chairman",
          "chairwoman",
          "chairperson",
          "chair of the board"
        ]
      },
      {
        "name": "founder",
        "inverse": "organization",
        "synonyms": [
          "founder",
          "co-founder",
          "cofounder"
        ]
      },
      {
        "name": "board_member",
        "inverse": "organization",
        "synonyms": [
          "board member",
          "director on the board",
          "non-executive director"
        ]
      },
      {
        "name": "owner",
        "inverse": "organization",
        "synonyms": [
          "owner",
          "co-owner",
          "shareholder"
        ]
      },
      {
        "name": "employee",
        "inverse": "employer",
        "synonyms": [
          "employee",
          "staff",
          "engineer",
          "developer",
          "manager",
          "analyst"
        ]
      },
      {
        "name": "contractor",
        "inverse": "client",
        "synonyms": [
          "contractor",
          "consultant",
          "freelancer"
        ]
      },
      {
        "name": "student",
        "inverse": "school",
        "synonyms": [
          "student",
          "pupil",
          "graduate student",
          "phd student"
        ]
      },
      {
        "name": "member",
        "inverse": "organization",
        "synonyms": [
          "member"
        ]
      },
      {
        "name": "volunteer",
        "inverse": "organization",
        "synonyms": [
          "volunteer"
        ]
      }
    ],
    "example": "kevin.relate(acme, \"membership\", title=\"logistics lead\")",
    "reads": "Kevin belongs to Acme as logistics lead — the member is the subject"
  },
  "attributes": [
    {
      "name": "label",
      "type": "str",
      "required": false,
      "description": "What the user calls this relation, in their words."
    },
    {
      "name": "role",
      "type": "str",
      "required": false,
      "description": "Their role from this type's roles (ceo, founder, employee…); filled from the label or title when it matches one."
    },
    {
      "name": "title",
      "type": "str",
      "required": false,
      "description": "Their position in their own words: 'vendor logistics lead', 'Head of Engineering'."
    },
    {
      "name": "kind",
      "type": "enum[employment, study, club, volunteer, other]",
      "required": false,
      "description": "What kind of belonging.",
      "default": "employment"
    },
    {
      "name": "primary",
      "type": "bool",
      "required": false,
      "description": "The main one — what Person.organization shows. One at a time.",
      "default": false
    },
    {
      "name": "team",
      "type": "str",
      "required": false,
      "description": "Team or group inside the organization."
    }
  ],
  "methods": []
}
